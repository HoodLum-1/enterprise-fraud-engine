# Fraud Engine - environment variables
#
# Copy to .env and adjust:  cp .env.example .env
# Load it into the shell:    set -a && . ./.env && set +a
# Docker Compose reads .env automatically for the ${...} substitutions below.
#
# The values below are the local development ones. They match what Compose gives the
# containers, except for the host and container difference: from the host the database is
# on localhost, from inside the fraud-engine container it is on postgres.

# ---------------------------------------------------------------------------
# Required by the application outside the dev profile
# ---------------------------------------------------------------------------

# PostgreSQL. The main application.yml has no defaults for these on purpose.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/fraud_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Kafka bootstrap servers.
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# The JWT issuer the service trusts. It has to be the issuer that is in the token, so it
# has to be the URL the Keycloak is reachable at, not the internal container URL.
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=http://localhost:8180/realms/fraud-engine

# ---------------------------------------------------------------------------
# Optional application settings
# ---------------------------------------------------------------------------

# Set to false to turn the JWT resource server off. Only for local work; the dev profile
# already does this.
SECURITY_ENABLED=true

# Skip the OIDC discovery and fetch the keys from this URL instead. Leave it unset to use
# discovery against the issuer above.
#SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI=http://localhost:8180/realms/fraud-engine/protocol/openid-connect/certs

# The profile to run. The dev profile disables security, adds the development seed data and
# provides the localhost defaults for the variables above, so it needs none of them.
#SPRING_PROFILES_ACTIVE=dev

# ---------------------------------------------------------------------------
# Compose substitution
# ---------------------------------------------------------------------------

# Host port for PostgreSQL. Change it if 5432 is already taken.
POSTGRES_PORT=5432

# Host port for Prometheus, which only runs in the observability profile.
PROMETHEUS_PORT=9090

# ---------------------------------------------------------------------------
# Developer scripts
# ---------------------------------------------------------------------------

# run.sh
#COMPOSE_FILE=compose.yaml
#HEALTH_ENDPOINT=http://localhost:8080/actuator/health
#MAX_HEALTH_RETRIES=60
#HEALTH_RETRY_INTERVAL=2

# smoke-test.sh and smoke-test-with-auth.sh
#BASE_URL=http://localhost:8080
#KEYCLOAK_URL=http://localhost:8180
#KEYCLOAK_USERNAME=fraud-analyst
#KEYCLOAK_PASSWORD=fraud-analyst-dev

# load-test.sh
#TOTAL_REQUESTS=200
#CONCURRENCY=20
#API_ENDPOINT=/api/v1/transactions/evaluate
#AUTH_TOKEN=
